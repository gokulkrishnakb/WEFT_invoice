# Backend API
VITE_API_URL=http://localhost:8000/api/v1

# Money format (ISO 4217 currency + locale), e.g. INR/en-IN, USD/en-US, AED/en-AE
VITE_CURRENCY=INR
VITE_LOCALE=en-IN

# Seller details printed on every invoice (leave a line empty to hide it)
VITE_COMPANY_NAME=Ledgerly Trading Co.
VITE_COMPANY_ADDRESS=2nd Floor, Marine Drive, Kochi, Kerala 682031
VITE_COMPANY_EMAIL=accounts@ledgerly.example
VITE_COMPANY_PHONE=+91 484 000 0000
VITE_COMPANY_TAX_ID=
VITE_INVOICE_NOTE=Thank you for your business. Payment is due within 30 days of the invoice date.
